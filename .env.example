# App Settings
PROJECT_NAME="FinTrack"
API_V1_STR="/api/v1"
FRONTEND_URL="http://localhost:5173"

# Security Settings
SECRET_KEY="temporary-super-secret-key-change-me-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RESET_TOKEN_EXPIRE_MINUTES=15

# Database Settings
# For PostgreSQL development/production:
DATABASE_URL="postgresql://user:password@localhost:5432/fintrack"

# CORS Origins (Comma separated list)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Google OAuth 2.0 (Get from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Brevo (Sendinblue) Email SMTP Settings
# (If left empty, password reset links will print directly to the backend terminal for dev testing)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="no-reply@fintrack.local"
EMAILS_FROM_NAME="FinTrack Support"
