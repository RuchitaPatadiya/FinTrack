# App Settings
PROJECT_NAME="FinTrack"
API_V1_STR="/api/v1"

# Security Settings
# Generate a secure key in production (e.g., openssl rand -hex 32)
SECRET_KEY="temporary-super-secret-key-change-me-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings
# For local SQLite development (default):
DATABASE_URL="sqlite:///./fintrack.db"
# For PostgreSQL development/production:
# DATABASE_URL="postgresql://user:password@localhost:5432/fintrack"

# CORS Origins (Comma separated list)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
